# Copy this file to .env and replace placeholders with your own credentials.
MONGO_ROOT_USER=stockpilot_admin
MONGO_ROOT_PASSWORD=change-me
MONGO_DB=stockpilot

# Local Docker:
MONGO_URI=mongodb://stockpilot_admin:change-me@127.0.0.1:27017/?authSource=admin

# MongoDB Atlas instead:
# MONGO_URI=mongodb+srv://YOUR_ATLAS_USERNAME:YOUR_ATLAS_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority

PORT=4000
